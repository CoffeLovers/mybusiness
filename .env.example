# General & Environment
NODE_ENV=development
PORT=3000

# API Gateway Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-change-in-production
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=super-cookie-secret-random-32-chars

# Redis Broker & Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mybusiness_redis_secret

# Microservices Ports (Transport TCP)
AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3001

FINANCE_SERVICE_HOST=localhost
FINANCE_SERVICE_PORT=3002

AGENT_SERVICE_HOST=localhost
AGENT_SERVICE_PORT=3003

AUDIT_SERVICE_HOST=localhost
AUDIT_SERVICE_PORT=3004

# Database per Service (PostgreSQL 16 + pgvector)
AUTH_DATABASE_URL=postgresql://mybusiness_user:mybusiness_pass@localhost:5432/auth_db?schema=public
FINANCE_DATABASE_URL=postgresql://mybusiness_user:mybusiness_pass@localhost:5432/finance_db?schema=public
AGENT_DATABASE_URL=postgresql://mybusiness_user:mybusiness_pass@localhost:5432/agent_db?schema=public
AUDIT_DATABASE_URL=postgresql://mybusiness_user:mybusiness_pass@localhost:5432/audit_db?schema=public
