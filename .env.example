# ==============================================================================
# MyBusiness Monorepo — Variables de Entorno de Ejemplo (Desarrollo Local)
# ADVERTENCIA: Valores estrictamente de ejemplo para desarrollo local.
# NO USAR estos valores en entornos de producción.
# ==============================================================================

# General & Environment
NODE_ENV=development
PORT=3000

# API Gateway Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=mybusiness
JWT_AUDIENCE=mybusiness-api
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=super-cookie-secret-random-32-chars

# Cookies de autenticación (en producción debe ser true; en local HTTP puede ser false)
AUTH_COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# Redis 7 (Message Broker RPC, Event Bus Pub/Sub, Colas BullMQ y Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_in_production_redis_secret

# ------------------------------------------------------------------------------
# PostgreSQL 16 + pgvector (Database-per-Service con Mínimos Privilegios)
# ------------------------------------------------------------------------------
# Credenciales del usuario administrativo (solo inicialización y mantenimiento de Docker)
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=mybusiness_admin
POSTGRES_PASSWORD=change_in_production_postgres_admin_pass
POSTGRES_DB=auth_db

# Si cambias POSTGRES_PORT (por ejemplo, porque 5432 está ocupado), actualiza
# también el puerto de las cuatro *_DATABASE_URL al mismo valor.
POSTGRES_PORT=5432

# Credenciales de servicio con privilegio mínimo por base de datos
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_in_production_auth_pass
AUTH_DATABASE_URL=postgresql://auth_user:change_in_production_auth_pass@localhost:5432/auth_db?schema=public

FINANCE_DB_USER=finance_user
FINANCE_DB_PASSWORD=change_in_production_finance_pass
FINANCE_DATABASE_URL=postgresql://finance_user:change_in_production_finance_pass@localhost:5432/finance_db?schema=public

AGENT_DB_USER=agent_user
AGENT_DB_PASSWORD=change_in_production_agent_pass
AGENT_DATABASE_URL=postgresql://agent_user:change_in_production_agent_pass@localhost:5432/agent_db?schema=public

AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=change_in_production_audit_pass
AUDIT_DATABASE_URL=postgresql://audit_user:change_in_production_audit_pass@localhost:5432/audit_db?schema=public

# ------------------------------------------------------------------------------
# Datos del seed de desarrollo (no usar en producción)
# ------------------------------------------------------------------------------
SEED_TENANT_LEGAL_NAME=MyBusiness Demo S.A.S.
SEED_TENANT_TRADE_NAME=MyBusiness Demo
SEED_TENANT_TAX_ID=change_me_seed_tax_id
SEED_TENANT_COUNTRY=CO
SEED_TENANT_CURRENCY=COP
SEED_TENANT_TIMEZONE=America/Bogota
SEED_TENANT_LOCALE=es-CO
SEED_ADMIN_EMAIL=change_me_seed_admin_email@example.test
SEED_ADMIN_PASSWORD=change_me_seed_admin_password
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Demo
