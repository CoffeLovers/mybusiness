# ==============================================================================
# MyBusiness Monorepo — Variables de Entorno de Ejemplo (Desarrollo Local)
# ADVERTENCIA: Valores estrictamente de ejemplo para desarrollo local.
# NO USAR estos valores en entornos de producción.
# ==============================================================================

# General & Environment
NODE_ENV=development
PORT=3000

# API Gateway Security
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=mybusiness
JWT_AUDIENCE=mybusiness-api
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECRET=super-cookie-secret-random-32-chars

# Cookies de autenticación (en producción debe ser true; en local HTTP puede ser false)
AUTH_COOKIE_SECURE=false

# Rate limiting (defaults de producción; el entorno de carga los sobreescribe)
THROTTLE_AUTH_LIMIT=5
THROTTLE_AUTH_TTL_MS=60000
THROTTLE_API_LIMIT=100
THROTTLE_API_TTL_MS=60000
THROTTLE_HEAVY_LIMIT=10
THROTTLE_HEAVY_TTL_MS=60000

# ------------------------------------------------------------------------------
# Redis 7 (Message Broker RPC, Event Bus Pub/Sub, Colas BullMQ y Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_in_production_redis_secret

# ------------------------------------------------------------------------------
# PostgreSQL 16 + pgvector (Database-per-Service con Mínimos Privilegios)
# ------------------------------------------------------------------------------
# Credenciales del usuario administrativo (solo inicialización y mantenimiento de Docker)
POSTGRES_HOST=127.0.0.1
POSTGRES_USER=mybusiness_admin
POSTGRES_PASSWORD=change_in_production_postgres_admin_pass
POSTGRES_DB=auth_db

# Si cambias POSTGRES_PORT (por ejemplo, porque 5432 está ocupado), actualiza
# también el puerto de las cuatro *_DATABASE_URL al mismo valor.
POSTGRES_PORT=5432

# Credenciales de servicio con privilegio mínimo por base de datos
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_in_production_auth_pass
AUTH_DATABASE_URL=postgresql://auth_user:change_in_production_auth_pass@localhost:5432/auth_db?schema=public

FINANCE_DB_USER=finance_user
FINANCE_DB_PASSWORD=change_in_production_finance_pass
FINANCE_DATABASE_URL=postgresql://finance_user:change_in_production_finance_pass@localhost:5432/finance_db?schema=public

AGENT_DB_USER=agent_user
AGENT_DB_PASSWORD=change_in_production_agent_pass
AGENT_DATABASE_URL=postgresql://agent_user:change_in_production_agent_pass@localhost:5432/agent_db?schema=public

AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=change_in_production_audit_pass
AUDIT_DATABASE_URL=postgresql://audit_user:change_in_production_audit_pass@localhost:5432/audit_db?schema=public

# ------------------------------------------------------------------------------
# Datos del seed de desarrollo (no usar en producción)
# ------------------------------------------------------------------------------
SEED_TENANT_LEGAL_NAME=MyBusiness Demo S.A.S.
SEED_TENANT_TRADE_NAME=MyBusiness Demo
SEED_TENANT_TAX_ID=change_me_seed_tax_id
SEED_TENANT_COUNTRY=CO
SEED_TENANT_CURRENCY=COP
SEED_TENANT_TIMEZONE=America/Bogota
SEED_TENANT_LOCALE=es-CO
SEED_ADMIN_EMAIL=change_me_seed_admin_email@example.test
SEED_ADMIN_PASSWORD=change_me_seed_admin_password
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Demo

# ------------------------------------------------------------------------------
# Embeddings (agent-service)
# mock = determinista, sólo desarrollo/test. En producción usar openai.
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# Token Governance & Budget (agent-service - SF3-03)
# ------------------------------------------------------------------------------
# Presupuesto mensual por tenant en USD (convertido a micro-USD en el servicio). Default: 50.00 USD
AGENT_TOKEN_BUDGET_USD_MONTHLY=50.00
# Ratio de advertencia (0.01 a 1.0) para alertar proximidad al límite. Default: 0.8 (80%)
AGENT_BUDGET_WARN_RATIO=0.8
# Habilita o deshabilita la caché semántica en agent_db. Default: true
AGENT_CACHE_ENABLED=true
# Umbral mínimo de similitud coseno (0.5 a 1.0) para match semántico en caché. Default: 0.95
AGENT_CACHE_SIMILARITY_THRESHOLD=0.95
# TTL corto para datos financieros (1..3600 s). Default: 300 (5 min).
# Datos financieros: TTL corto por defecto; el orquestador debe invalidar por snapshot de datos si amplía el TTL.
AGENT_CACHE_TTL_SECONDS=300
# Modo degradado determinista sin LLM cuando se agota el presupuesto. Default: true
AGENT_DEGRADED_MODE_ENABLED=true
# Coste por 1K tokens de entrada (prompt) en USD (0..1000). Default: 0.0015 USD
AGENT_MODEL_INPUT_COST_PER_1K_USD=0.0015
# Coste por 1K tokens de salida (completion) en USD (0..1000). Default: 0.002 USD
AGENT_MODEL_OUTPUT_COST_PER_1K_USD=0.002

# ------------------------------------------------------------------------------
# Bank Aggregators (Plaid + Belvo)
# ------------------------------------------------------------------------------
# BANK AGGREGATORS
# Clave AES-256 de 32 bytes. Generar con: openssl rand -hex 32
BANK_ENCRYPTION_KEY=
BANK_ENCRYPTION_KEY_VERSION=v1

# Sólo permite el fallback en NODE_ENV=development o test. Nunca usar en staging/producción.
BANK_ENCRYPTION_ALLOW_INSECURE_DEV_KEY=false

# Key ring JSON opcional para rotación de claves. Las claves deben cumplir el mismo formato de 32 bytes (64 hex o base64 de 32 bytes).
# BANK_ENCRYPTION_KEY_RING={"v0":"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}

# PLAID
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
PLAID_WEBHOOK_URL=
PLAID_API_VERSION=2020-09-14

# BELVO
BELVO_ENV=sandbox
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_BASE_URL=https://sandbox.belvo.com
BELVO_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Portal web (BFF)
# ------------------------------------------------------------------------------
# Secreto de sellado de la cookie de sesión (>= 32 caracteres). Obligatorio.
WEB_SESSION_SECRET=
# URL interna del API Gateway para las llamadas servidor-a-servidor.
WEB_GATEWAY_URL=http://127.0.0.1:3000
# Orígenes permitidos para mutaciones del BFF (separados por coma).
WEB_ALLOWED_ORIGINS=http://localhost:3001
# Forzar cookies Secure fuera de producción (p. ej. detrás de TLS).
WEB_SECURE_COOKIES=false

# ------------------------------------------------------------------------------
# Colas durables (BullMQ, SF2-06)
# ------------------------------------------------------------------------------
# Concurrencia por defecto de cada worker (1-50). Se puede sobrescribir por cola:
# QUEUE_CONCURRENCY_BANKING_SYNC, QUEUE_CONCURRENCY_OCR,
# QUEUE_CONCURRENCY_RECONCILIATION, QUEUE_CONCURRENCY_NOTIFICATIONS
QUEUE_CONCURRENCY=5
# Tiempo máximo de espera de jobs en curso durante el apagado (1000-300000 ms).
QUEUE_SHUTDOWN_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Documentos y OCR (SF2-07)
# ------------------------------------------------------------------------------
# Almacenamiento: local (desarrollo sin S3) o s3 (MinIO/AWS).
DOCUMENT_STORAGE_DRIVER=local
DOCUMENTS_LOCAL_DIR=/tmp/mybusiness-documents
S3_BUCKET=mybusiness-documents
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# OCR: stub (determinista, solo desarrollo/test) o mindee.
OCR_PROVIDER=stub
OCR_CONFIDENCE_THRESHOLD=0.85
MINDEE_API_KEY=
MINDEE_BASE_URL=https://api.mindee.net/v1
MINDEE_MODEL=invoices

# ------------------------------------------------------------------------------
# Conciliación bancaria (SF2-11)
# ------------------------------------------------------------------------------
# Tamaño de lote para procesamiento de movimientos y documentos en memoria (default: 500)
RECONCILIATION_BATCH_SIZE=500

# ------------------------------------------------------------------------------
# Servidor MCP interno (SF3-04)
# ------------------------------------------------------------------------------
# Invocaciones por minuto y tenant antes de devolver RATE_LIMITED.
MCP_RATE_LIMIT_PER_MINUTE=60

# ------------------------------------------------------------------------------
# OpenTelemetry / trazas (SF3-07)
# ------------------------------------------------------------------------------
# Master switch de instrumentación. Default OFF: con `false` (o sin definir) los
# servicios no registran SDK ni exportan nada (cero impacto).
OTEL_ENABLED=false
# Endpoint OTLP del collector (URL COMPLETA por señal, protocolo http_json).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Protocolo del exportador: `http` (default) o `grpc` (usa OTEL_COLLECTOR_GRPC_PORT).
OTEL_EXPORTER_OTLP_PROTOCOL=http
# Ratio de muestreo de trazas raíz (0..1). Changear sin recompilar.
OTEL_TRACES_SAMPLER_RATE=1
# Nombre por proceso ("api-gateway", "auth-service", ...). No definir lo sobreescribe cada main.
# OTEL_SERVICE_NAME=api-gateway

# Puertos del stack de trazas en docker compose (collector + Jaeger UI).
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
JAEGER_UI_PORT=16686
