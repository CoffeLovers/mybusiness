{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KotlinContractMap",
  "type": "object",
  "required": ["version", "mappings"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "kotlinClass",
          "schema",
          "allowlistKotlinFields",
          "allowlistSchemaFields",
          "rationale"
        ],
        "properties": {
          "source": { "type": "string" },
          "kotlinClass": { "type": "string" },
          "schema": { "type": "string" },
          "allowlistKotlinFields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "allowlistSchemaFields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
