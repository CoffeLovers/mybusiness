{
  "version": "1.0.0",
  "issue": "#90",
  "fecha": "2026-11-04",
  "estado": "Aprobado para RD-02/RD-06",
  "documentacion": "docs/design/tokens.md",
  "reglas": "docs/design/DESIGN-RULES.md",
  "palettes": {
    "light": {
      "surface": "#ffffff",
      "surfaceRaised": "#f4f6f8",
      "border": "#c3ccd6",
      "borderStrong": "#6b7280",
      "text": "#101720",
      "textMuted": "#55606f",
      "primary": "#1d4ed8",
      "onPrimary": "#ffffff",
      "income": "#047857",
      "expense": "#b91c1c",
      "neutral": "#4b5563",
      "alert": "#92400e",
      "focusRing": "#1d4ed8",
      "accent": "#ddf84b",
      "onAccent": "#000000",
      "inverse": "#1a1a1a",
      "inverseRaised": "#262626",
      "onInverse": "#ffffff",
      "inverseMuted": "#b3b3b3"
    },
    "dark": {
      "surface": "#0b0f16",
      "surfaceRaised": "#151b24",
      "border": "#3f4b5c",
      "borderStrong": "#7c8ba1",
      "text": "#f2f5f8",
      "textMuted": "#a3aebd",
      "primary": "#7aa2ff",
      "onPrimary": "#0b0f16",
      "income": "#34d399",
      "expense": "#f87171",
      "neutral": "#9aa5b4",
      "alert": "#fbbf24",
      "focusRing": "#7aa2ff",
      "accent": "#ddf84b",
      "onAccent": "#000000",
      "inverse": "#1a1a1a",
      "inverseRaised": "#262626",
      "onInverse": "#ffffff",
      "inverseMuted": "#b3b3b3"
    }
  },
  "roles": {
    "surface": {
      "capa": "semantica",
      "uso": "Fondo base de la vista. Equivale a colorScheme.surface en Compose.",
      "informativo": true
    },
    "surfaceRaised": {
      "capa": "semantica",
      "uso": "Tarjetas, tablas, paneles y cualquier contenedor elevado sobre surface.",
      "informativo": true
    },
    "border": {
      "capa": "semantica",
      "uso": "Separadores y contornos decorativos. No delimita controles por si solo.",
      "informativo": false,
      "nota": "Decorativo: WCAG 1.4.11 no aplica. Si el borde delimita un control, se usa borderStrong."
    },
    "borderStrong": {
      "capa": "semantica",
      "uso": "Borde de controles interactivos y limites que transmiten informacion.",
      "informativo": true,
      "nota": "Debe cumplir 3:1 contra las superficies adyacentes."
    },
    "text": {
      "capa": "semantica",
      "uso": "Texto primario y contenido de lectura.",
      "informativo": true
    },
    "textMuted": {
      "capa": "semantica",
      "uso": "Metadatos, ayudas, placeholders y etiquetas secundarias.",
      "informativo": true
    },
    "primary": {
      "capa": "semantica",
      "uso": "Accion primaria, enlaces y fondo del anillo de foco derivado.",
      "informativo": true
    },
    "onPrimary": {
      "capa": "semantica",
      "uso": "Texto e iconos sobre primary.",
      "informativo": true,
      "nota": "Nombre canonico del rol: on-primary/onPrimary. El alias primary-contrast/primaryContrast se elimino en RD-02 (#91); no quedan alias ni nombres alternativos."
    },
    "income": {
      "capa": "semantica",
      "uso": "Entradas de dinero e importes positivos.",
      "informativo": true
    },
    "expense": {
      "capa": "semantica",
      "uso": "Salidas de dinero e importes negativos.",
      "informativo": true
    },
    "neutral": {
      "capa": "semantica",
      "uso": "Importes sin signo y estados neutros.",
      "informativo": true
    },
    "alert": {
      "capa": "semantica",
      "uso": "Advertencias y errores de estado de baja severidad.",
      "informativo": true
    },
    "focusRing": {
      "capa": "semantica",
      "uso": "Anillo de foco visible sobre superficies claras y oscuras.",
      "informativo": true
    },
    "accent": {
      "capa": "semantica",
      "uso": "Acento de marca lima: cintas, realces y texto sobre la superficie inversa.",
      "informativo": true,
      "nota": "Mismos valores en claro y oscuro. No se usa como texto sobre surface claro: 1.19:1, no alcanza AA. Sobre inverse alcanza 14.59:1."
    },
    "onAccent": {
      "capa": "semantica",
      "uso": "Texto e iconos sobre accent.",
      "informativo": true,
      "nota": "17.60:1 sobre accent; cumple AA y AAA."
    },
    "inverse": {
      "capa": "semantica",
      "uso": "Superficie de una seccion invertida (siempre oscura), no fondo global de la vista.",
      "informativo": true,
      "nota": "Mismos valores en claro y oscuro. No sustituye a surface: se usa solo en bloques invertidos."
    },
    "inverseRaised": {
      "capa": "semantica",
      "uso": "Tarjetas y paneles elevados dentro de una seccion invertida.",
      "informativo": true
    },
    "onInverse": {
      "capa": "semantica",
      "uso": "Texto e iconos primarios sobre inverse.",
      "informativo": true,
      "nota": "17.40:1 sobre inverse; cumple AA y AAA."
    },
    "inverseMuted": {
      "capa": "semantica",
      "uso": "Metadatos, ayudas y etiquetas secundarias dentro de una seccion invertida.",
      "informativo": true,
      "nota": "8.30:1 sobre inverse; cumple AA y AAA."
    }
  },
  "contrast": {
    "textMin": 4.5,
    "uiMin": 3,
    "text": [
      { "fg": "text", "bg": "surface" },
      { "fg": "text", "bg": "surfaceRaised" },
      { "fg": "textMuted", "bg": "surface" },
      { "fg": "textMuted", "bg": "surfaceRaised" },
      { "fg": "onPrimary", "bg": "primary" },
      { "fg": "primary", "bg": "surface" },
      { "fg": "primary", "bg": "surfaceRaised" },
      { "fg": "income", "bg": "surface" },
      { "fg": "income", "bg": "surfaceRaised" },
      { "fg": "expense", "bg": "surface" },
      { "fg": "expense", "bg": "surfaceRaised" },
      { "fg": "neutral", "bg": "surface" },
      { "fg": "neutral", "bg": "surfaceRaised" },
      { "fg": "alert", "bg": "surface" },
      { "fg": "alert", "bg": "surfaceRaised" },
      { "fg": "onAccent", "bg": "accent" },
      { "fg": "onInverse", "bg": "inverse" },
      { "fg": "inverseMuted", "bg": "inverse" },
      { "fg": "accent", "bg": "inverse" }
    ],
    "ui": [
      { "fg": "focusRing", "bg": "surface" },
      { "fg": "focusRing", "bg": "surfaceRaised" },
      { "fg": "borderStrong", "bg": "surface" },
      { "fg": "borderStrong", "bg": "surfaceRaised" },
      { "fg": "text", "bg": "surface" },
      { "fg": "textMuted", "bg": "surface" },
      { "fg": "onPrimary", "bg": "primary" },
      { "fg": "accent", "bg": "inverse" }
    ]
  },
  "spacing": {
    "base": 4,
    "allowedMultiplesOf": 4,
    "escala": [4, 8, 12, 16, 24, 32, 40, 48, 64, 80, 96],
    "unidad": "px",
    "nota": "A partir de 16 px se recomienda paso de 8. Dimensiones de componentes, iconos y grosores no son tokens de spacing.",
    "tokens": {
      "space-1": 4,
      "space-2": 8,
      "space-3": 12,
      "space-4": 16,
      "space-6": 24,
      "space-8": 32,
      "space-10": 40,
      "space-12": 48,
      "space-16": 64,
      "space-20": 80,
      "space-24": 96
    }
  },
  "radii": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "full": 9999
  },
  "typography": {
    "web": {
      "ratio": 1.25,
      "basePx": 16,
      "nota": "xl a 4xl siguen el ratio 1.25; lg, sm y xs usan pasos convencionales fijados en globals.css.",
      "escala": {
        "xs": { "px": 12, "rem": "0.75rem", "lineHeight": 1.5 },
        "sm": { "px": 14, "rem": "0.875rem", "lineHeight": 1.5 },
        "base": { "px": 16, "rem": "1rem", "lineHeight": 1.5 },
        "lg": { "px": 18, "rem": "1.125rem", "lineHeight": 1.5 },
        "xl": { "px": 20, "rem": "1.25rem", "lineHeight": 1.4 },
        "2xl": { "px": 25, "rem": "1.5625rem", "lineHeight": 1.3 },
        "3xl": { "px": 31.25, "rem": "1.953rem", "lineHeight": 1.25 },
        "4xl": { "px": 39.06, "rem": "2.441rem", "lineHeight": 1.2 }
      }
    },
    "android": {
      "fuente": "FontFamily.Default",
      "estilos": {
        "headlineLarge": { "sp": 32, "lineHeightSp": 40, "weight": "Bold" },
        "headlineMedium": { "sp": 28, "lineHeightSp": 36, "weight": "SemiBold" },
        "headlineSmall": { "sp": 24, "lineHeightSp": 32, "weight": "SemiBold" },
        "titleLarge": { "sp": 20, "lineHeightSp": 28, "weight": "SemiBold" },
        "titleMedium": { "sp": 16, "lineHeightSp": 24, "weight": "Medium" },
        "titleSmall": { "sp": 14, "lineHeightSp": 20, "weight": "Medium" },
        "bodyLarge": { "sp": 16, "lineHeightSp": 24, "weight": "Normal" },
        "bodyMedium": { "sp": 14, "lineHeightSp": 20, "weight": "Normal" },
        "bodySmall": { "sp": 12, "lineHeightSp": 16, "weight": "Normal" },
        "labelLarge": { "sp": 14, "lineHeightSp": 20, "weight": "Medium" }
      }
    },
    "mapping": [
      {
        "web": "4xl",
        "android": null,
        "nota": "Sin equivalente en Type.kt; candidato a displaySmall en RD-06."
      },
      { "web": "3xl", "android": "headlineLarge", "nota": "31.25 px frente a 32 sp." },
      { "web": "2xl", "android": "headlineMedium", "nota": "25 px frente a 28 sp: divergencia." },
      {
        "web": "xl",
        "android": "titleLarge",
        "nota": "20 px frente a 20 sp, pero titleLarge usa SemiBold y line-height 28."
      },
      { "web": "lg", "android": "titleLarge", "nota": "18 px frente a 20 sp: divergencia." },
      { "web": "base", "android": "bodyLarge", "nota": "16 px frente a 16 sp." },
      { "web": "sm", "android": "bodyMedium", "nota": "14 px frente a 14 sp." },
      { "web": "xs", "android": "bodySmall", "nota": "12 px frente a 12 sp." }
    ]
  },
  "elevation": {
    "unidad": "nivel",
    "escala": {
      "0": 0,
      "1": 1,
      "2": 3,
      "3": 6
    },
    "regla": "La elevacion no sustituye al contraste; un contenedor elevado sigue necesitando borde o superficie diferenciada."
  },
  "motion": {
    "duration": {
      "fast": "150ms",
      "base": "200ms",
      "slow": "300ms"
    },
    "easing": {
      "enter": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0.0, 1, 1)",
      "standard": "cubic-bezier(0.4, 0.0, 0.2, 1)"
    },
    "reducedMotion": "respetar prefers-reduced-motion / animator duration scale del sistema"
  }
}
