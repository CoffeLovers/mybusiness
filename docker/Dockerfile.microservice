# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------------
# Base Image: Debian Bookworm Slim con Node.js 22 LTS
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH NODE_ENV=production
RUN corepack enable
RUN apt-get update \
  && apt-get upgrade -y --no-install-recommends \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /repo

# ------------------------------------------------------------------------------
# Stage 1: Dependencias del monorepo
# ------------------------------------------------------------------------------
FROM base AS deps
ARG SERVICE_NAME
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/${SERVICE_NAME}/package.json ./apps/${SERVICE_NAME}/package.json
RUN pnpm install --frozen-lockfile --filter @mybusiness/${SERVICE_NAME}...

# ------------------------------------------------------------------------------
# Stage 2: Compilación de paquetes y microservicio
# ------------------------------------------------------------------------------
FROM deps AS builder
ARG SERVICE_NAME
COPY apps/${SERVICE_NAME} ./apps/${SERVICE_NAME}
RUN pnpm --filter @mybusiness/contracts build \
  && pnpm --filter @mybusiness/telemetry build \
  && pnpm --filter @mybusiness/common build \
  && pnpm --filter @mybusiness/${SERVICE_NAME} build

# ------------------------------------------------------------------------------
# Stage 3: Runner de Producción Hardened (Non-Root, Sin Tooling innecesario)
# ------------------------------------------------------------------------------
FROM node:22-bookworm-slim AS runner
ARG SERVICE_NAME
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
WORKDIR /app

# Hardening: Eliminar herramientas de paquete (npm, yarn, corepack) no usadas en runtime
RUN rm -rf \
  /opt/yarn-* \
  /usr/local/lib/node_modules/corepack \
  /usr/local/lib/node_modules/npm \
  /usr/local/bin/corepack \
  /usr/local/bin/npm \
  /usr/local/bin/npx \
  /usr/local/bin/yarn \
  /usr/local/bin/yarnpkg

# Copiar artefactos compilados y dependencias de producción
COPY --from=builder --chown=node:node /repo/node_modules ./node_modules
COPY --from=builder --chown=node:node /repo/packages ./packages
COPY --from=builder --chown=node:node /repo/apps/${SERVICE_NAME}/dist ./dist
COPY --from=builder --chown=node:node /repo/apps/${SERVICE_NAME}/package.json ./package.json

# Criterio estricto de seguridad: Ejecución con usuario no privilegiado (USER node, UID 1000)
USER node

# Healthcheck estandarizado de orquestación (/healthz/liveness)
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "http.get('http://127.0.0.1:' + (process.env.HEALTH_PORT || process.env.PORT || 3000) + '/healthz/liveness', (r) => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"

CMD ["node", "dist/main.js"]
